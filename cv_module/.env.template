# CV Module Environment Configuration Template
# Copy this file to .env and modify as needed
# Do not commit .env files to version control

# Environment Selection
CV_MODULE_ENV=development                # Options: development, production

# Service Settings
CV_MODULE_HOST=localhost                 # Service host address
CV_MODULE_PORT=8765                      # Service port number
CV_MODULE_LOG_DIR=logs/dev              # Log directory path
CV_MODULE_LOG_LEVEL=INFO                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Camera Settings
CV_MODULE_CAMERA_TYPE=webcam            # Options: webcam, realsense
CV_MODULE_CAMERA_ID=0                   # Camera device ID (for webcam)

# Detector Settings
CV_MODULE_MODEL_NAME=yolov8n.pt         # Options: yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
CV_MODULE_MODEL_CONFIDENCE=0.4          # Detection confidence threshold (0.0-1.0)

# WebSocket Settings
CV_MODULE_WS_MAX_CLIENTS=10             # Maximum number of WebSocket clients
CV_MODULE_WS_MESSAGE_QUEUE=100          # WebSocket message queue size 